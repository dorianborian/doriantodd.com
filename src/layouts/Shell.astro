---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, NAV, getProjects } from '../lib/site';
import { getCollection } from 'astro:content';
import gear from '../assets/gear.png';

interface Props {
  title?: string;
  /** Title for search results and link previews, if it should differ from the on-page title. */
  seoTitle?: string;
  description?: string;
  /** Key of the generated preview card, /og/<key>.jpg (see src/pages/og). Defaults to the home card. */
  ogKey?: string;
  ogAlt?: string;
  /** 'article' for projects and guides, 'profile' for the about page. */
  ogType?: 'website' | 'article' | 'profile';
  keywords?: string[];
  /** schema.org JSON-LD for this page (see src/lib/seo.ts). */
  jsonld?: object;
  modified?: string;
  /** Keep this page out of search results (the 404 page). */
  noindex?: boolean;
  leftTitle?: string;
  rightTitle?: string;
}

const { title, seoTitle, description = `${SITE.name}: ${SITE.tagline}.`, ogKey = 'home', ogAlt, ogType = 'website', keywords = [], jsonld, modified, noindex = false, leftTitle = 'Features', rightTitle = 'Properties' } = Astro.props;
const base = seoTitle ?? title;
// page titles stand on their own; the site name is carried by og:site_name and the home page
const pageTitle = base ?? `${SITE.name} | ${SITE.tagline}`;
// browser tabs get the short page title; search results and link previews get the descriptive one
const tabTitle = title ?? SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`/og/${ogKey}.jpg`, Astro.site).href;
const GA_ID = 'G-9R1Y855NBE';
const xHandle = '@' + (SITE.social.find((s) => s.label === 'X')?.handle ?? '');
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? here === '/' : here === href);

const projects = await getProjects();
const pages = (await getCollection('pages')).filter((p) => p.data.path !== '/');
const searchIndex = [
  ...NAV.map((n) => ({ t: n.label, u: n.href, k: 'page' })),
  ...projects.map((p) => ({ t: p.entry.data.title, u: p.url, k: p.no, s: p.entry.data.tags.join(' ') + ' ' + (p.entry.data.summary ?? '') })),
  ...pages.filter((p) => !NAV.some((n) => n.href === p.data.path)).map((p) => ({ t: p.data.title, u: p.data.path, k: 'page' })),
].filter((it, i, all) => all.findIndex((o) => o.u === it.u) === i);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={SITE.name} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#202125" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for language models" />
    {SITE.social.map((s) => <link rel="me" href={s.url} />)}
    <link rel="me" href="https://www.youtube.com/@DorianToddYT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? pageTitle} />
    {ogType === 'article' && <meta property="article:author" content={new URL('/about/', Astro.site).href} />}
    {ogType === 'article' && modified && <meta property="article:modified_time" content={modified} />}
    {ogType === 'article' && keywords.slice(0, 6).map((k) => <meta property="article:tag" content={k} />)}
    {ogType === 'profile' && <meta property="profile:first_name" content="Dorian" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Todd" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt ?? pageTitle} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {import.meta.env.PROD && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          // Google Analytics 4 (the same property the old Google Sites site used). Only on the real domain.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          if (/(^|\.)doriantodd\.com$/.test(location.hostname)) {
            gtag('js', new Date());
            gtag('config', GA_ID);
          }
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <div class="shell" id="shell">
      <header class="topbar">
        <button class="icon-btn nav-toggle" data-action="drawer" aria-label="Open menu"><Icon name="menu" /></button>
        <a class="brand" href="/">
          <span class="brand-mark">
            <img src={gear.src} width="20" height="20" alt="" />
          </span>
          <span class="brand-doc">
            <strong>{SITE.name}</strong>
            <span>{SITE.tagline}</span>
          </span>
        </a>
        <nav class="topnav" aria-label="Primary">
          {NAV.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="top-right">
          <button class="search-btn" data-action="palette" aria-label="Search">
            <Icon name="search" size={14} /><span class="search-label">Search projects</span><kbd class="hide-mobile">Ctrl K</kbd>
          </button>
          <a class="icon-btn hide-mobile" href="https://github.com/dorianborian" aria-label="GitHub" rel="me noopener"><Icon name="github" /></a>
          <button class="icon-btn hide-mobile" data-action="toggle-left" aria-pressed="true" aria-label="Toggle left panel"><Icon name="panelLeft" /></button>
          <button class="icon-btn hide-mobile" data-action="toggle-right" aria-pressed="true" aria-label="Toggle right panel"><Icon name="panelRight" /></button>
        </div>
      </header>

      <div class="toolbar" role="toolbar" aria-label="Tools">
        <slot name="toolbar" />
      </div>

      <aside class="panel panel-left" aria-label={leftTitle}>
        <nav class="drawer-nav" aria-label="Pages">
          {NAV.map((n) => <a class="tree-item" href={n.href} aria-current={isCurrent(n.href) ? 'true' : undefined}>{n.label}</a>)}
        </nav>
        <div class="panel-head"><Icon name="extrude" size={13} />{leftTitle}
          <button class="icon-btn only-mobile" data-action="drawer" aria-label="Close"><Icon name="close" size={14} /></button>
        </div>
        <div class="panel-body"><slot name="left" /></div>
      </aside>

      <main class="main" id="main">
        <slot />
      </main>

      <aside class="panel panel-right" aria-label={rightTitle}>
        <div class="panel-head"><Icon name="info" size={13} />{rightTitle}</div>
        <div class="panel-body"><slot name="right" /></div>
      </aside>
    </div>

    <div class="palette" id="palette" hidden>
      <div class="palette-box" role="dialog" aria-modal="true" aria-label="Search">
        <div class="palette-input"><Icon name="search" /><input type="text" placeholder="Search projects and pages" aria-label="Search" autocomplete="off" spellcheck="false" /><kbd>Esc</kbd></div>
        <ul class="palette-list" role="listbox"></ul>
      </div>
    </div>
    <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />

    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
